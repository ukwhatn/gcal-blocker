    "eslint": "^9.17.0",
    "gas-webpack-plugin": "^2.6.0",
    "globals": "^15.14.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.18.2",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  }
}
